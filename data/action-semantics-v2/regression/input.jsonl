{"case_id": "C01", "meeting_id": "ES2002a", "series": "ES2002", "language": "en", "source": "AMI_1.6.2", "meeting_date": "13-12-04", "segments": [{"id": "ES2002a.B.dialog-act.dharshi.32", "start_ms": 151790, "end_ms": 158410, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "Um and at this point we get try out the whiteboard over there."}, {"id": "ES2002a.B.dialog-act.dharshi.27", "start_ms": 158410, "end_ms": 159590, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "Um."}, {"id": "ES2002a.B.dialog-act.dharshi.33", "start_ms": 159590, "end_ms": 165910, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "So uh you get to draw your favourite animal and sum up your favourite characteristics of it."}, {"id": "ES2002a.B.dialog-act.dharshi.30", "start_ms": 165910, "end_ms": 167310, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "So who would like to go first?"}, {"id": "ES2002a.D.dialog-act.dharshi.8", "start_ms": 166670, "end_ms": 167810, "speaker": "D", "speaker_name": "Marketing Expert", "person_ref": "MEE008", "text": "I will go. That's fine."}, {"id": "ES2002a.B.dialog-act.dharshi.34", "start_ms": 167840, "end_ms": 169072, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "Very good."}], "participants": [{"speaker": "A", "speaker_name": "Industrial Designer", "person_ref": "MEE006"}, {"speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005"}, {"speaker": "C", "speaker_name": "User Interface Designer", "person_ref": "MEE007"}, {"speaker": "D", "speaker_name": "Marketing Expert", "person_ref": "MEE008"}]}
