# Explicit publication roots; local research material stays on disk.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/meeting_eval/
!/prompts/
!/scripts/
!/tests/
!/experiments/
!/examples/
!/docs/
!/config/
!/data/
!/runs/

# Credentials, caches, databases and downloaded media.
**/__pycache__/
*.py[cod]
.env
.env.*
!/.env.example
*.sqlite
*.sqlite-*
*.db
*.db-*
*.pem
*.key
*.p12
*.pfx
.venv/
venv/
*.zip
*.mp4
*.mp3
*.wav
*.rm
*.lock
**/raw/
**/clips/
/data/generalization-v1/

# Only the reviewed two-meeting evidence, not raw model logs.
/runs/*
!/runs/2026-11-18-two-unseen-v19/
/runs/2026-11-18-two-unseen-v19/*
!/runs/2026-11-18-two-unseen-v19/evaluation.json
