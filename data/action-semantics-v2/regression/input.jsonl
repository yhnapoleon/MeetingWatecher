{"case_id": "C03", "meeting_id": "ES2002a", "series": "ES2002", "language": "en", "source": "AMI_1.6.2", "meeting_date": "13-12-04", "segments": [{"id": "ES2002a.B.dialog-act.dharshi.199", "start_ms": 996690, "end_ms": 1000990, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "Um for user interface, technical functions,"}, {"id": "ES2002a.B.dialog-act.dharshi.200", "start_ms": 1000990, "end_ms": 1003160, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "I guess that's you know like what we've been talking about,"}, {"id": "ES2002a.B.dialog-act.dharshi.201", "start_ms": 1003160, "end_ms": 1004080, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "what it'll actually do."}, {"id": "ES2002a.B.dialog-act.dharshi.202", "start_ms": 1004080, "end_ms": 1008750, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "Um and uh marketing executive,"}, {"id": "ES2002a.B.dialog-act.dharshi.203", "start_ms": 1010020, "end_ms": 1016480, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "you'll be just thinking about what it actually what, you know, what requirements it has to has to fulfil"}, {"id": "ES2002a.B.dialog-act.dharshi.204", "start_ms": 1016480, "end_ms": 1019310, "speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005", "text": "and you'll all get instructions emailed to you, I guess."}, {"id": "ES2002a.D.dialog-act.dharshi.173", "start_ms": 1019670, "end_ms": 1020010, "speaker": "D", "speaker_name": "Marketing Expert", "person_ref": "MEE008", "text": "Okay."}], "participants": [{"speaker": "A", "speaker_name": "Industrial Designer", "person_ref": "MEE006"}, {"speaker": "B", "speaker_name": "Project Manager", "person_ref": "FEE005"}, {"speaker": "C", "speaker_name": "User Interface Designer", "person_ref": "MEE007"}, {"speaker": "D", "speaker_name": "Marketing Expert", "person_ref": "MEE008"}