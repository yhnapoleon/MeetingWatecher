{"case_id": "PF01", "meeting_id": "PF01", "series": "synthetic-prerequisite-PF01", "language": "zh", "source": "synthetic_mechanism_check", "meeting_date": "2026-11-14", "participants": [{"speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"speaker": "Z", "speaker_name": "小周", "person_ref": "probe_zhou"}], "segments": [{"id": "PF01.s1", "text": "小林，请整理展会报名名单。", "speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"id": "PF01.s2", "text": "好，我来整理展会报名名单。", "speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"id": "PF01.s3", "text": "展会取消，报名名单不用整理了。", "speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"id": "PF01.s4", "text": "收到，不整理名单了。", "speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"id": "PF01.s5", "text": "小周，取消后需要通知已经报名的人。", "speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"id": "PF01.s6", "text": "我来通知这些报名者展会取消。", "speaker": "Z", "speaker_name": "小周", "person_ref": "probe_zhou"}]}
{"case_id": "PF02", "meeting_id": "PF02", "series": "synthetic-prerequisite-PF02", "language": "zh", "source": "synthetic_mechanism_check", "meeting_date": "2026-11-14", "participants": [{"speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"speaker": "Z", "speaker_name": "小周", "person_ref": "probe_zhou"}], "segments": [{"id": "PF02.s1", "text": "今天分别安排春季展会和秋季展会的准备工作。", "speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"id": "PF02.s2", "text": "我会整理春季展会的报名名单。", "speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"id": "PF02.s3", "text": "我会整理秋季展会的报名名单。", "speaker": "Z", "speaker_name": "小周", "person_ref": "probe_zhou"}, {"id": "PF02.s4", "text": "春季展会取消，春季的名单不用整理；秋季展会不受影响。", "speaker": "P", "speaker_name": "主持人", "person_ref": "probe_pm"}, {"id": "PF02.s5", "text": "收到，春季名单不整理了。", "speaker": "L", "speaker_name": "小林", "person_ref": "probe_lin"}, {"id": "PF02.s6", "text": "秋季的名单仍由我整理。", "speaker": "Z", "speaker_name": "小周", "person_ref": "probe_zhou"}]}
